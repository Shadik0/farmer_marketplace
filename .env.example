# Environment Configuration Template for AgriMarket (HACK-P309)
# Copy this file to .env and configure your local settings.

# Server settings
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=True

# Database Configuration
DATABASE_URL=sqlite:///./backend/marketplace.db

# Security & CORS (Origins allowed in production)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Feature Flags
ENABLE_DEMO_RESET=True
SIMULATED_PAYMENTS_ONLY=True
